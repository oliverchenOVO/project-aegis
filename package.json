{
  "name": "project-aegis",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sim:run": "tsx scripts/sim-run.ts",
    "benchmark": "tsx benchmarks/run.ts",
    "desktop": "electron apps/desktop/dist/main.cjs",
    "package:win": "pnpm build && node scripts/package-windows.mjs",
    "smoke": "tsx tests/e2e/phase2-smoke.ts",
    "smoke:legacy": "tsx tests/e2e/desktop-smoke.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "latest",
    "eslint": "^9.39.0",
    "prettier": "3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.aegis.command",
    "productName": "Project AEGIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "apps/desktop/dist/main.cjs"
    },
    "asar": true,
    "portable": {
      "unpackDirName": true
    },
    "win": {
      "target": "portable",
      "icon": "assets/aegis.ico",
      "signAndEditExecutable": true
    },
    "artifactName": "AEGIS-${version}-Windows-${arch}.${ext}"
  },
  "description": "Deterministic emergency command simulation with information fog and replay",
  "author": "CHEN, KUEI-HENG"
}
